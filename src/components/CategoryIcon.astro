---
/** 分野のアイコン（イラスト）。name は各大分類の index の frontmatter `icon` */
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<svg class="cat-icon" viewBox="0 0 48 48" aria-hidden="true">
  <rect x="1" y="1" width="46" height="46" rx="12" class="ci-bg"></rect>
  {
    name === 'basics' && (
      <g>
        <text x="10" y="22" class="ci-text" font-size="13">01</text>
        <text x="26" y="38" class="ci-text ci-c2" font-size="16">∑</text>
        <path d="M12 34 L22 26" class="ci-line ci-c3" />
        <circle cx="34" cy="15" r="5" class="ci-fill ci-c4" />
      </g>
    )
  }
  {
    name === 'computer' && (
      <g>
        <rect x="14" y="14" width="20" height="20" rx="3" class="ci-fill ci-c1" />
        <rect x="19" y="19" width="10" height="10" rx="1.5" class="ci-inner" />
        {[18, 24, 30].map((p) => (
          <g class="ci-line ci-c1">
            <path d={`M${p} 9 V14 M${p} 34 V39 M9 ${p} H14 M34 ${p} H39`} />
          </g>
        ))}
      </g>
    )
  }
  {
    name === 'network' && (
      <g>
        <path d="M24 13 L12 33 M24 13 L36 33 M12 33 H36" class="ci-line ci-c1" />
        <circle cx="24" cy="13" r="5" class="ci-fill ci-c2" />
        <circle cx="12" cy="33" r="5" class="ci-fill ci-c3" />
        <circle cx="36" cy="33" r="5" class="ci-fill ci-c4" />
      </g>
    )
  }
  {
    name === 'media' && (
      <g>
        <rect x="9" y="12" width="30" height="20" rx="3" class="ci-fill ci-c5" />
        <path d="M21 17 L29 22 L21 27 z" class="ci-inner" />
        <path d="M19 37 H29 M24 32 V37" class="ci-line ci-c5" />
      </g>
    )
  }
  {
    name === 'database' && (
      <g>
        <path d="M12 14 V34 C12 38 36 38 36 34 V14" class="ci-fill ci-c2" />
        <ellipse cx="24" cy="14" rx="12" ry="4" class="ci-fill ci-c1" />
        <path d="M12 21 C12 25 36 25 36 21 M12 28 C12 32 36 32 36 28" class="ci-line ci-inner-line" />
      </g>
    )
  }
  {
    name === 'security' && (
      <g>
        <path d="M24 8 L37 13 V23 C37 31 31 37 24 40 C17 37 11 31 11 23 V13 z" class="ci-fill ci-c1" />
        <path d="M18 24 L22.5 28.5 L30.5 19.5" class="ci-line ci-inner-line" stroke-width="3" />
      </g>
    )
  }
  {
    name === 'development' && (
      <g>
        <path d="M18 15 L9 24 L18 33" class="ci-line ci-c1" stroke-width="3.5" />
        <path d="M30 15 L39 24 L30 33" class="ci-line ci-c1" stroke-width="3.5" />
        <path d="M27 12 L21 36" class="ci-line ci-c4" stroke-width="3.5" />
      </g>
    )
  }
  {
    name === 'management' && (
      <g>
        <rect x="10" y="12" width="16" height="6" rx="2" class="ci-fill ci-c1" />
        <rect x="17" y="21" width="18" height="6" rx="2" class="ci-fill ci-c2" />
        <rect x="24" y="30" width="14" height="6" rx="2" class="ci-fill ci-c3" />
        <path d="M9 9 V39 H40" class="ci-line ci-muted" />
      </g>
    )
  }
  {
    name === 'strategy' && (
      <g>
        <rect x="10" y="28" width="6" height="10" rx="1.5" class="ci-fill ci-c2" />
        <rect x="20" y="22" width="6" height="16" rx="1.5" class="ci-fill ci-c1" />
        <rect x="30" y="15" width="6" height="23" rx="1.5" class="ci-fill ci-c5" />
        <path d="M9 21 L19 14 L27 17 L38 8" class="ci-line ci-c4" />
        <path d="M33 8 H38 V13" class="ci-line ci-c4" />
      </g>
    )
  }
</svg>

<style>
  .ci-bg {
    fill: var(--dg-fill);
    stroke: var(--dg-stroke);
  }
  .ci-fill {
    stroke: none;
  }
  .ci-line {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ci-text {
    font-weight: 700;
    font-family: ui-monospace, Menlo, monospace;
  }
  .ci-fill.ci-c1,
  .ci-text.ci-c1 {
    fill: var(--dg-c1);
  }
  .ci-fill.ci-c2,
  .ci-text.ci-c2 {
    fill: var(--dg-c2);
  }
  .ci-fill.ci-c3 {
    fill: var(--dg-c3);
  }
  .ci-fill.ci-c4 {
    fill: var(--dg-c4);
  }
  .ci-fill.ci-c5 {
    fill: var(--dg-c5);
  }
  .ci-text {
    fill: var(--dg-c1);
  }
  .ci-line.ci-c1,
  .ci-line.ci-c1 path {
    stroke: var(--dg-c1);
  }
  .ci-line.ci-c3 {
    stroke: var(--dg-c3);
  }
  .ci-line.ci-c4 {
    stroke: var(--dg-c4);
  }
  .ci-line.ci-c5 {
    stroke: var(--dg-c5);
  }
  .ci-line.ci-muted {
    stroke: var(--fg-muted);
  }
  .ci-inner {
    fill: var(--bg);
  }
  .ci-inner-line {
    stroke: var(--bg);
  }
</style>
