---
/**
 * RPO（目標復旧時点）と RTO（目標復旧時間）を 1 本の時間軸で見せる図。
 * 最後のバックアップ → 障害発生 → 業務再開 を順に表示し、
 * 障害から過去向きの「失うデータ」（RPO と比べる）と、未来向きの「停止時間」（RTO と比べる）をステップ再生で示す。
 *
 * 使い方（.mdx）:
 *   <RecoveryTimeline />
 *   <RecoveryTimeline backup={3} failure={9} recovery={13} />   … 時刻（時、0〜24 の整数）
 */
import Figure from './Figure.astro';

interface Props {
  title?: string;
  caption?: string;
  /** 最後にバックアップを取得した時刻（時） */
  backup?: number;
  /** 障害が発生した時刻（時） */
  failure?: number;
  /** 業務を再開した時刻（時） */
  recovery?: number;
}
const { title = 'RPO と RTO', caption, backup = 3, failure = 9, recovery = 13 } = Astro.props;

const lost = failure - backup;
const down = recovery - failure;
// 時間軸: 左右の余白を除いた幅に、バックアップ〜業務再開を収める
const left = 56;
const right = 356;
const scale = (right - left) / (recovery - backup);
const xb = left;
const xf = left + lost * scale;
const xr = right;
const axisY = 112;
const brY = 64;
const hm = (h: number) => `${h}:00`;

const narration = [
  `${hm(failure)} に障害が発生し、データベースが使えなくなりました。`,
  `最後のバックアップ（${hm(backup)}）の時点までしか戻せないので、それ以降の ${lost} 時間分の更新が失われます。この「どの時点まで戻せればよいか」の目標が RPO です。`,
  `復旧作業を終えて ${hm(recovery)} に業務を再開しました。停止していた ${down} 時間が、「どれだけの時間で復旧するか」の目標である RTO 以内に収まっている必要があります。`,
];
---

<Figure title={title} caption={caption} steps={narration.length} interval={4000} intro={`${hm(backup)} にバックアップを取得し、その後も業務でデータが更新されています。`}>
  <svg class="rt" viewBox="0 0 400 184" style="max-width: 560px; margin: 0 auto;" role="img" aria-label={`時間軸の図。${hm(backup)} に最後のバックアップ、${hm(failure)} に障害発生、${hm(recovery)} に業務再開。失うデータは ${lost} 時間分で RPO と比べ、停止時間は ${down} 時間で RTO と比べる`}>
    <defs>
      <marker id="rt-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" class="rt-arrowhead"></path>
      </marker>
    </defs>

    <!-- 時間軸 -->
    <line x1="16" y1={axisY} x2="392" y2={axisY} class="rt-axis" marker-end="url(#rt-arrow)" />

    <!-- 失うデータ（バックアップ〜障害） -->
    <g data-step="2">
      <rect x={xb} y={axisY - 9} width={xf - xb} height="18" class="rt-lost" />
      <path d={`M${xb},${brY + 10} V${brY} H${xf} V${brY + 10}`} class="rt-bracket rt-bracket-rpo dg-draw" />
      <text x={(xb + xf) / 2} y={brY - 32} text-anchor="middle" class="rt-term rt-term-rpo">RPO と比べる</text>
      <text x={(xb + xf) / 2} y={brY - 10} text-anchor="middle" class="rt-desc">失うデータ {lost} 時間分</text>
    </g>

    <!-- 停止時間（障害〜業務再開） -->
    <g data-step="3">
      <rect x={xf} y={axisY - 9} width={xr - xf} height="18" class="rt-down" />
      <path d={`M${xf},${brY + 10} V${brY} H${xr} V${brY + 10}`} class="rt-bracket rt-bracket-rto dg-draw" />
      <text x={(xf + xr) / 2} y={brY - 32} text-anchor="middle" class="rt-term rt-term-rto">RTO と比べる</text>
      <text x={(xf + xr) / 2} y={brY - 10} text-anchor="middle" class="rt-desc">停止 {down} 時間</text>
    </g>

    <!-- できごと -->
    <g>
      <circle cx={xb} cy={axisY} r="8" class="rt-dot rt-dot-backup" />
      <text x={xb} y={axisY + 34} text-anchor="middle" class="rt-event">バックアップ</text>
      <text x={xb} y={axisY + 58} text-anchor="middle" class="rt-time">{hm(backup)}</text>
    </g>
    <g data-step="1">
      <circle cx={xf} cy={axisY} r="8" class="rt-dot rt-dot-failure" />
      <text x={xf} y={axisY + 34} text-anchor="middle" class="rt-event rt-event-failure">障害発生</text>
      <text x={xf} y={axisY + 58} text-anchor="middle" class="rt-time">{hm(failure)}</text>
    </g>
    <g data-step="3">
      <circle cx={xr} cy={axisY} r="8" class="rt-dot rt-dot-recovery" />
      <text x={xr} y={axisY + 34} text-anchor="middle" class="rt-event">業務再開</text>
      <text x={xr} y={axisY + 58} text-anchor="middle" class="rt-time">{hm(recovery)}</text>
    </g>
  </svg>
  <Fragment slot="narration">
    {narration.map((t, i) => <p data-step-only={i + 1}>{t}</p>)}
  </Fragment>
</Figure>

<style>
  .rt-axis {
    stroke: var(--fg-muted);
    stroke-width: 2;
  }
  .rt-arrowhead {
    fill: var(--fg-muted);
  }
  .rt-lost {
    fill: color-mix(in srgb, var(--dg-c4) 30%, transparent);
  }
  .rt-down {
    fill: color-mix(in srgb, var(--dg-warn) 30%, transparent);
  }
  .rt-bracket {
    fill: none;
    stroke-width: 2;
  }
  .rt-bracket-rpo {
    stroke: var(--dg-c4);
  }
  .rt-bracket-rto {
    stroke: var(--dg-warn);
  }
  .rt-dot {
    stroke: var(--bg);
    stroke-width: 2;
  }
  .rt-dot-backup {
    fill: var(--dg-c1);
  }
  .rt-dot-failure {
    fill: var(--dg-warn);
  }
  .rt-dot-recovery {
    fill: var(--dg-ok);
  }
  :global(.diagram-body) svg .rt-term {
    font-weight: 700;
    font-size: 18px;
  }
  :global(.diagram-body) svg .rt-term-rpo {
    fill: var(--dg-c4);
  }
  :global(.diagram-body) svg .rt-term-rto {
    fill: var(--dg-warn);
  }
  :global(.diagram-body) svg .rt-desc {
    font-size: 17px;
  }
  :global(.diagram-body) svg .rt-event {
    font-weight: 700;
    font-size: 17px;
  }
  :global(.diagram-body) svg .rt-event-failure {
    fill: var(--dg-warn);
  }
  :global(.diagram-body) svg .rt-time {
    font-size: 16px;
    fill: var(--fg-muted);
  }
</style>
