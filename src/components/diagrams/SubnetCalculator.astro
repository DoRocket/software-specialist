---
/**
 * サブネット計算機。IPv4 アドレスとプレフィックス長を変えると、32 ビットをネットワーク部／ホスト部で
 * 色分けし、ネットワークアドレス・ブロードキャストアドレス・割当て可能な範囲・ホスト数を即時に表示する。
 *
 * 使い方（.mdx）:
 *   <SubnetCalculator />
 *   <SubnetCalculator ip="10.0.5.77" prefix={20} title="…" />
 * - アドレス欄に「192.168.1.130/26」のように入力すると、プレフィックス長も読み取る。
 */
import Figure from './Figure.astro';

interface Props {
  title?: string;
  caption?: string;
  ip?: string;
  prefix?: number;
}
const { title = 'サブネット計算機', caption, ip = '192.168.1.130', prefix = 26 } = Astro.props;

const bitRows = [
  { key: 'ip', label: 'IPアドレス' },
  { key: 'mask', label: 'サブネットマスク' },
  { key: 'net', label: 'AND の結果（ネットワークアドレス）' },
];
const octets = [0, 1, 2, 3];
const bits = [0, 1, 2, 3, 4, 5, 6, 7];
---

<Figure title={title} caption={caption}>
  <div class="snc" data-subnet-calc>
    <div class="dg-controls snc-controls">
      <label class="snc-field">
        <span>IPv4 アドレス</span>
        <input
          class="dg-mono snc-ip"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          spellcheck="false"
          value={ip}
          data-snc-ip
        />
      </label>
      <label class="snc-field snc-prefix-field">
        <span>プレフィックス長 <b class="dg-mono" data-snc-prefix-out>/{prefix}</b></span>
        <span class="snc-prefix-inputs">
          <input type="range" min="0" max="32" step="1" value={prefix} data-snc-prefix-range aria-label="プレフィックス長（スライダー）" />
          <input class="dg-mono snc-prefix-num" type="number" min="0" max="32" step="1" value={prefix} data-snc-prefix-num aria-label="プレフィックス長（数値）" />
        </span>
      </label>
    </div>

    <p class="snc-error" data-snc-error hidden></p>

    <div class="snc-bits" data-snc-bits>
      <div class="snc-legend">
        <span><i class="snc-swatch snc-net-sw"></i>ネットワーク部</span>
        <span><i class="snc-swatch snc-host-sw"></i>ホスト部</span>
      </div>
      {
        bitRows.map((r) => (
          <div class="snc-bitrow" data-snc-row={r.key}>
            <span class="snc-bitlabel">{r.label}</span>
            <span class="snc-bitcells dg-mono">
              {octets.map((o) => (
                <span class="snc-octet">
                  {bits.map((b) => (
                    <span class="snc-bit" data-i={o * 8 + b}>
                      0
                    </span>
                  ))}
                  <span class="snc-dec" data-snc-dec={o}>
                    0
                  </span>
                </span>
              ))}
            </span>
          </div>
        ))
      }
    </div>

    <dl class="dg-result snc-result">
      <div>
        <dt>サブネットマスク</dt>
        <dd class="dg-mono" data-snc-out="mask">—</dd>
      </div>
      <div>
        <dt>ネットワークアドレス</dt>
        <dd class="dg-mono" data-snc-out="network">—</dd>
      </div>
      <div>
        <dt>ブロードキャストアドレス</dt>
        <dd class="dg-mono" data-snc-out="broadcast">—</dd>
      </div>
      <div>
        <dt>割当て可能な範囲</dt>
        <dd class="dg-mono" data-snc-out="range">—</dd>
      </div>
      <div>
        <dt>アドレス数</dt>
        <dd data-snc-out="count">—</dd>
      </div>
      <div>
        <dt>割当て可能なホスト数</dt>
        <dd data-snc-out="hosts">—</dd>
      </div>
    </dl>
    <p class="snc-note" data-snc-note></p>
  </div>
</Figure>

<style>
  .snc-controls {
    align-items: flex-end;
  }
  .snc-field {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .snc-field > span:first-child {
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  .snc-field b {
    color: var(--fg);
    font-size: 0.95rem;
  }
  .snc-ip {
    width: 12.5em;
  }
  .snc-ip[aria-invalid='true'] {
    border-color: var(--dg-warn);
    outline-color: var(--dg-warn);
  }
  .snc-prefix-field {
    flex: 1 1 14em;
  }
  .snc-prefix-inputs {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .snc-prefix-inputs input[type='range'] {
    flex: 1;
    min-width: 8em;
    padding: 0;
    accent-color: var(--accent);
  }
  .snc-prefix-num {
    width: 4.2em;
  }
  .snc-error {
    margin: 0 0 10px;
    padding: 6px 10px;
    border-left: 4px solid var(--dg-warn);
    border-radius: 4px;
    background: color-mix(in srgb, var(--dg-warn) 12%, var(--bg));
    font-size: 0.88rem;
  }
  .snc-bits {
    margin-bottom: 12px;
    overflow-x: auto;
  }
  .snc-bits.is-invalid {
    opacity: 0.35;
  }
  .snc-legend {
    display: flex;
    gap: 14px;
    margin-bottom: 4px;
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  .snc-swatch {
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    margin-right: 4px;
    border-radius: 3px;
    vertical-align: -0.1em;
  }
  .snc-net-sw {
    background: color-mix(in srgb, var(--dg-c1) 35%, var(--bg));
    border: 1px solid var(--dg-c1);
  }
  .snc-host-sw {
    background: color-mix(in srgb, var(--dg-c3) 35%, var(--bg));
    border: 1px solid var(--dg-c3);
  }
  .snc-bitrow {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin-top: 6px;
  }
  .snc-bitlabel {
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .snc-bitcells {
    display: flex;
    gap: 6px;
  }
  .snc-octet {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: auto auto;
    flex: 1;
    min-width: 0;
  }
  .snc-bit {
    padding: 2px 0;
    text-align: center;
    font-size: 0.85rem;
    line-height: 1.4;
    background: color-mix(in srgb, var(--dg-c3) 30%, var(--bg));
    border-top: 2px solid var(--dg-c3);
  }
  .snc-bit.is-net {
    background: color-mix(in srgb, var(--dg-c1) 30%, var(--bg));
    border-top-color: var(--dg-c1);
  }
  .snc-bit.is-one {
    font-weight: 700;
  }
  .snc-bit.is-boundary {
    box-shadow: inset 2px 0 0 var(--dg-warn);
  }
  .snc-dec {
    grid-column: 1 / -1;
    text-align: center;
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .snc-result {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14em, 1fr));
    gap: 6px 16px;
    margin: 0;
  }
  .snc-result div {
    display: flex;
    flex-direction: column;
  }
  .snc-result dt {
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .snc-result dd {
    margin: 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .snc-note {
    margin: 8px 0 0;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .snc-note:empty {
    display: none;
  }
</style>

<script>
  const SUP: Record<string, string> = { '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
  const sup = (n: number) => String(n).replace(/\d/g, (d) => SUP[d]);
  const toDotted = (v: number) => [24, 16, 8, 0].map((s) => (v >>> s) & 255).join('.');
  const fmt = (n: number) => n.toLocaleString('ja-JP');

  /** 「a.b.c.d」を 32 ビットの符号なし整数に。不正なら null */
  function parseIPv4(text: string): number | null {
    const parts = text.split('.');
    if (parts.length !== 4) return null;
    let v = 0;
    for (const p of parts) {
      if (!/^\d{1,3}$/.test(p)) return null;
      const n = Number(p);
      if (n > 255) return null;
      v = v * 256 + n;
    }
    return v >>> 0;
  }

  function setup(root: HTMLElement) {
    const ipIn = root.querySelector<HTMLInputElement>('[data-snc-ip]')!;
    const range = root.querySelector<HTMLInputElement>('[data-snc-prefix-range]')!;
    const num = root.querySelector<HTMLInputElement>('[data-snc-prefix-num]')!;
    const prefixOut = root.querySelector<HTMLElement>('[data-snc-prefix-out]')!;
    const errorEl = root.querySelector<HTMLElement>('[data-snc-error]')!;
    const bitsEl = root.querySelector<HTMLElement>('[data-snc-bits]')!;
    const noteEl = root.querySelector<HTMLElement>('[data-snc-note]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-snc-out="${k}"]`)!;
    let prefix = Number(range.value);

    const paintRow = (key: string, value: number) => {
      const row = root.querySelector<HTMLElement>(`[data-snc-row="${key}"]`)!;
      for (const cell of row.querySelectorAll<HTMLElement>('.snc-bit')) {
        const i = Number(cell.dataset.i);
        const bit = (value >>> (31 - i)) & 1;
        cell.textContent = String(bit);
        cell.classList.toggle('is-one', bit === 1);
        cell.classList.toggle('is-net', i < prefix);
        cell.classList.toggle('is-boundary', i === prefix && prefix > 0 && prefix < 32);
      }
      row.querySelectorAll<HTMLElement>('[data-snc-dec]').forEach((d) => {
        d.textContent = String((value >>> (24 - 8 * Number(d.dataset.sncDec))) & 255);
      });
    };

    const update = () => {
      prefixOut.textContent = `/${prefix}`;
      const mask = prefix === 0 ? 0 : (0xffffffff << (32 - prefix)) >>> 0;
      out('mask').textContent = `${toDotted(mask)}（/${prefix}）`;

      const raw = ipIn.value.trim();
      const ip = parseIPv4(raw);
      if (ip === null) {
        ipIn.setAttribute('aria-invalid', 'true');
        errorEl.hidden = false;
        errorEl.textContent =
          raw === ''
            ? 'IPv4 アドレスを入力してください（例: 192.168.1.130）。'
            : `「${raw}」は IPv4 アドレスとして読めません。0〜255 の数を「.」で 4 つ区切って入力してください（例: 192.168.1.130）。`;
        bitsEl.classList.add('is-invalid');
        paintRow('mask', mask);
        // 読めないアドレスのビットは前の値を残さず「?」にする
        for (const key of ['ip', 'net']) {
          const row = root.querySelector<HTMLElement>(`[data-snc-row="${key}"]`)!;
          row.querySelectorAll<HTMLElement>('.snc-bit').forEach((c) => {
            c.textContent = '?';
            c.classList.remove('is-one');
          });
          row.querySelectorAll<HTMLElement>('[data-snc-dec]').forEach((d) => (d.textContent = '?'));
        }
        for (const k of ['network', 'broadcast', 'range', 'count', 'hosts']) out(k).textContent = '—';
        noteEl.textContent = '';
        return;
      }
      ipIn.removeAttribute('aria-invalid');
      errorEl.hidden = true;
      bitsEl.classList.remove('is-invalid');

      const network = (ip & mask) >>> 0;
      const hostBits = 32 - prefix;
      const size = 2 ** hostBits;
      const broadcast = (network + size - 1) >>> 0;
      paintRow('ip', ip);
      paintRow('mask', mask);
      paintRow('net', network);

      out('network').textContent = toDotted(network);
      out('broadcast').textContent = hostBits >= 2 ? toDotted(broadcast) : '—（ホスト部が 1 ビット以下）';
      out('count').textContent = `2${sup(hostBits)} = ${fmt(size)} 個`;
      if (hostBits >= 2) {
        out('range').textContent = `${toDotted(network + 1)} 〜 ${toDotted(broadcast - 1)}`;
        out('hosts').textContent = `2${sup(hostBits)} − 2 = ${fmt(size - 2)} 台`;
      } else {
        out('range').textContent = '—';
        out('hosts').textContent = `2${sup(hostBits)} − 2 ≦ 0 → なし`;
      }

      // 補足: 境界のあるオクテットの AND 計算、入力アドレスの種類
      const notes: string[] = [];
      if (prefix % 8 !== 0) {
        const o = Math.floor(prefix / 8);
        const sh = 24 - 8 * o;
        notes.push(
          `ネットワーク部とホスト部の境界は第${o + 1}オクテットの中にあります: ${(ip >>> sh) & 255} AND ${(mask >>> sh) & 255} = ${(network >>> sh) & 255}（/${prefix} では第${o + 1}オクテットが ${2 ** (8 - (prefix % 8))} ずつの区切り）。`,
        );
      }
      if (hostBits >= 2 && ip === network) notes.push('入力したアドレスはネットワークアドレスなので、ホストには割り当てられません。');
      if (hostBits >= 2 && ip === broadcast) notes.push('入力したアドレスはブロードキャストアドレスなので、ホストには割り当てられません。');
      if (hostBits === 1) notes.push('/31 はホスト部が 1 ビットしかなく、2ⁿ − 2 の式では割当て可能なホストがありません（ルータ同士を結ぶ回線などの特殊な用途に限り使われます）。');
      if (hostBits === 0) notes.push('/32 はホスト部がなく、1 台のホストそのもの（1 個のアドレス）を表します。');
      noteEl.textContent = notes.join(' ');
    };

    const setPrefix = (v: number, from?: HTMLInputElement) => {
      if (!Number.isFinite(v)) return;
      prefix = Math.min(32, Math.max(0, Math.round(v)));
      if (from !== range) range.value = String(prefix);
      if (from !== num) num.value = String(prefix);
      update();
    };

    ipIn.addEventListener('input', () => {
      // 「192.168.1.130/26」のような入力ではプレフィックス長も読み取る
      const m = ipIn.value.match(/^\s*([^/]*)\/\s*(\d{1,2})\s*$/);
      if (m && Number(m[2]) <= 32) {
        ipIn.value = m[1].trim();
        setPrefix(Number(m[2]));
        return;
      }
      update();
    });
    range.addEventListener('input', () => setPrefix(Number(range.value), range));
    num.addEventListener('input', () => {
      if (num.value === '') return;
      setPrefix(Number(num.value), num);
    });
    num.addEventListener('change', () => setPrefix(num.value === '' ? prefix : Number(num.value)));

    update();
  }

  document.querySelectorAll<HTMLElement>('[data-subnet-calc]').forEach(setup);
</script>
