---
/**
 * タスク（プロセス）の状態遷移図。実行可能・実行・待ちの 3 状態の間を、
 * 1 つのタスクがディスパッチ → プリエンプション → ディスパッチ → 入出力待ち → 入出力完了 と移る様子をステップ再生で見せる。
 * 最後のステップで「待ち → 実行 の遷移はない」ことを示す。
 *
 * 使い方（.mdx）:
 *   <TaskStateDiagram />
 */
import Figure from './Figure.astro';

interface Props {
  title?: string;
  caption?: string;
}
const { title = 'タスクの状態遷移', caption } = Astro.props;

type State = 'ready' | 'run' | 'wait';
const pos: Record<State, { x: number; y: number }> = {
  run: { x: 220, y: 46 },
  ready: { x: 86, y: 318 },
  wait: { x: 354, y: 318 },
};
const boxW = 160;
const boxH = 58;

/** 2 状態の中心を結ぶ線を、箱にかからないよう両端を縮め、垂直方向に off だけずらす */
function edge(from: State, to: State, off: number, trim = 50) {
  const a = pos[from];
  const b = pos[to];
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  const px = -uy * off;
  const py = ux * off;
  return {
    x1: a.x + ux * trim + px,
    y1: a.y + uy * trim + py,
    x2: b.x - ux * trim + px,
    y2: b.y - uy * trim + py,
    mx: (a.x + b.x) / 2 + px,
    my: (a.y + b.y) / 2 + py,
  };
}

const eDispatch = edge('ready', 'run', -10, 40);
const ePreempt = edge('run', 'ready', -10, 40);
const eIoReq = edge('run', 'wait', -10, 40);
const eNo = edge('wait', 'run', -10, 40);
const eIoDone = { x1: pos.wait.x - boxW / 2 - 8, y1: pos.wait.y, x2: pos.ready.x + boxW / 2 + 8, y2: pos.ready.y };

// 各ステップでタスクがいる状態
const where: State[] = ['ready', 'run', 'ready', 'run', 'wait', 'ready', 'ready'];
const steps = where.length - 1;
const token = (s: State) => ({ x: pos[s].x + boxW / 2 - 14, y: pos[s].y - boxH / 2 + 2 });

const narration = [
  'OS が CPU を割り当てる（ディスパッチ）と、実行状態になります。',
  'タイムクウォンタム（割当て時間）が終わる、またはより優先度の高いタスクが現れると、CPU を取り上げられて実行可能状態に戻ります（プリエンプション）。',
  '再びディスパッチされ、実行状態になります。',
  '入出力要求など、事象の発生を待つ必要が生じると、待ち状態になります。',
  '入出力の完了など、待っていた事象が発生すると、実行可能状態に戻ります。',
  '待ち状態から直接実行状態にはなりません。いったん実行可能状態に戻り、ディスパッチを待ちます。',
];
---

<Figure title={title} caption={caption} steps={steps} intro="タスクは実行可能状態で、CPU が割り当てられるのを待っています（●がタスク）。">
  <svg class="ts" viewBox="0 0 440 400" style="max-width: 540px; margin: 0 auto;" role="img" aria-label="タスクの状態遷移図。実行可能状態から実行状態へディスパッチ、実行状態から実行可能状態へプリエンプション、実行状態から待ち状態へ入出力要求、待ち状態から実行可能状態へ入出力完了">
    <defs>
      <marker id="ts-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="ts-arrowhead"></path>
      </marker>
      <marker id="ts-arrow-on" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="ts-arrowhead-on"></path>
      </marker>
    </defs>

    <!-- 遷移の矢印 -->
    <g class="ts-edge" data-on-steps="1 3">
      <line {...eDispatch} />
      <text x={eDispatch.mx - 18} y={eDispatch.my - 8} text-anchor="end" class="ts-elabel">ディスパッチ</text>
      <text x={eDispatch.mx - 18} y={eDispatch.my + 12} text-anchor="end" class="ts-esub">（CPU の割当て）</text>
    </g>
    <g class="ts-edge" data-on-steps="2">
      <line {...ePreempt} />
      <text x="240" y="244" text-anchor="middle" class="ts-elabel">プリエンプション</text>
      <text x="240" y="265" text-anchor="middle" class="ts-esub ts-esub-sm">タイムクウォンタムの終了、</text>
      <text x="240" y="283" text-anchor="middle" class="ts-esub ts-esub-sm">優先度の高いタスクの出現</text>
    </g>
    <g class="ts-edge" data-on-steps="4">
      <line {...eIoReq} />
      <text x={eIoReq.mx + 18} y={eIoReq.my - 8} class="ts-elabel">入出力要求など</text>
      <text x={eIoReq.mx + 18} y={eIoReq.my + 12} class="ts-esub">（事象の発生待ち）</text>
    </g>
    <g class="ts-edge" data-on-steps="5">
      <line {...eIoDone} />
      <text x={(pos.ready.x + pos.wait.x) / 2} y={pos.ready.y + 60} text-anchor="middle" class="ts-elabel">入出力の完了など</text>
    </g>
    <g class="ts-no" data-step="6">
      <line {...eNo} />
      <g transform={`translate(${eNo.mx} ${eNo.my})`}>
        <circle r="13" class="ts-no-bg" />
        <path d="M-6,-6 L6,6 M6,-6 L-6,6" class="ts-no-x" />
      </g>
      <rect x={eNo.mx - 104} y={eNo.my - 22} width="82" height="44" rx="6" class="ts-no-box" />
      <text x={eNo.mx - 63} y={eNo.my - 4} text-anchor="middle" class="ts-no-label">待ち→実行</text>
      <text x={eNo.mx - 63} y={eNo.my + 14} text-anchor="middle" class="ts-no-label">はない</text>
    </g>

    <!-- 状態 -->
    {
      (
        [
          ['run', '実行状態', 'CPU で処理中'],
          ['ready', '実行可能状態', 'CPU の割当て待ち'],
          ['wait', '待ち状態', '事象の発生待ち'],
        ] as [State, string, string][]
      ).map(([s, name, sub]) => (
        <g class="ts-state" data-on-steps={where.map((w, i) => (w === s ? i : -1)).filter((i) => i >= 0).join(' ')}>
          <rect x={pos[s].x - boxW / 2} y={pos[s].y - boxH / 2} width={boxW} height={boxH} rx="12" />
          <text x={pos[s].x} y={pos[s].y - 3} text-anchor="middle" class="ts-name">
            {name}
          </text>
          <text x={pos[s].x} y={pos[s].y + 18} text-anchor="middle" class="ts-sub">
            {sub}
          </text>
        </g>
      ))
    }

    <!-- タスク（●）。ステップごとに1つだけ表示し、前の位置から動いてくる -->
    {
      where.map((s, i) => {
        const t = token(s);
        const prev = token(where[Math.max(0, i - 1)]);
        return (
          <g class="ts-token-pos" transform={`translate(${t.x} ${t.y})`}>
            <g class="ts-token" data-step-only={i} style={`--fx: ${prev.x - t.x}px; --fy: ${prev.y - t.y}px;`}>
              <circle r="13" class="ts-token-dot" />
              <text y="5" text-anchor="middle" class="ts-token-label">
                T
              </text>
            </g>
          </g>
        );
      })
    }
  </svg>
  <Fragment slot="narration">
    {narration.map((n, i) => <p data-step-only={i + 1}>{n}</p>)}
  </Fragment>
</Figure>

<script>
  import '../../scripts/step-on';
</script>

<style>
  .ts-arrowhead {
    fill: var(--fg-muted);
  }
  .ts-arrowhead-on {
    fill: var(--accent);
  }
  .ts-edge line {
    stroke: var(--fg-muted);
    stroke-width: 2;
    marker-end: url(#ts-arrow);
    transition: stroke 0.3s ease;
  }
  .ts-edge.is-on line {
    stroke: var(--accent);
    stroke-width: 3;
    marker-end: url(#ts-arrow-on);
  }
  :global(.diagram-body) svg .ts-elabel {
    font-weight: 700;
    font-size: 16px;
  }
  :global(.diagram-body) svg .ts-esub {
    font-size: 14px;
    fill: var(--fg-muted);
  }
  :global(.diagram-body) svg .ts-esub-sm {
    font-size: 13px;
  }
  :global(.diagram-body) svg .is-on .ts-elabel {
    fill: var(--accent);
  }
  .ts-state rect {
    fill: var(--dg-fill);
    stroke: var(--dg-stroke);
    stroke-width: 1.5;
    transition: stroke 0.3s ease, fill 0.3s ease;
  }
  .ts-state.is-on rect {
    stroke: var(--accent);
    stroke-width: 3;
    fill: color-mix(in srgb, var(--accent) 14%, var(--dg-fill));
  }
  :global(.diagram-body) svg .ts-name {
    font-weight: 700;
    font-size: 17px;
  }
  :global(.diagram-body) svg .ts-sub {
    font-size: 14px;
    fill: var(--fg-muted);
  }
  .ts-no line {
    stroke: var(--dg-warn);
    stroke-width: 2;
    stroke-dasharray: 6 5;
  }
  .ts-no-box {
    fill: var(--bg);
    stroke: var(--dg-warn);
    stroke-width: 1.5;
  }
  .ts-no-bg {
    fill: var(--bg);
    stroke: var(--dg-warn);
    stroke-width: 2;
  }
  .ts-no-x {
    stroke: var(--dg-warn);
    stroke-width: 3;
    stroke-linecap: round;
  }
  :global(.diagram-body) svg .ts-no-label {
    fill: var(--dg-warn);
    font-weight: 700;
    font-size: 14px;
  }
  .ts-token-dot {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 2;
  }
  :global(.diagram-body) svg .ts-token-label {
    fill: var(--accent-fg);
    font-weight: 700;
    font-size: 14px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ts-token.is-visible {
      animation: ts-move 0.8s ease both;
    }
  }
  @keyframes ts-move {
    from {
      transform: translate(var(--fx), var(--fy));
    }
    to {
      transform: translate(0, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ts-edge line,
    .ts-state rect {
      transition: none;
    }
  }
</style>
