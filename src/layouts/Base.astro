---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import ExamFilter from '../components/ExamFilter.astro';
import TopicTreeList from '../components/TopicTreeList.astro';
import { getTopicTree, url } from '../lib/topics';

interface Props {
  title?: string;
  description?: string;
  /** サイドバーで現在位置を示すトピック id */
  currentId?: string;
}
const { title, description, currentId } = Astro.props;
const siteName = 'Software Specialist';
const tree = await getTopicTree();
const path = Astro.url.pathname;
const nav = [
  { href: url('tree'), label: '全体マップ' },
  { href: url('exams'), label: '試験別' },
  { href: url('tags'), label: 'タグ' },
  { href: url('practice'), label: '演習' },
  { href: url('progress'), label: '学習の記録' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${siteName}` : siteName}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg').replace(/\/$/, '')} />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <header class="site-header">
      <div class="site-header-inner">
        <button type="button" class="nav-toggle" aria-controls="sidebar" aria-expanded="false" data-nav-toggle>
          <span class="visually-hidden">メニュー</span>☰
        </button>
        <a class="site-title" href={url()}>{siteName}</a>
        <nav class="site-nav" aria-label="サイト">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
        <ExamFilter />
      </div>
    </header>
    <div class="layout">
      <aside class="sidebar" id="sidebar" aria-label="トピック一覧">
        <TopicTreeList nodes={tree.roots} currentId={currentId} />
      </aside>
      <main id="main" class="main">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <p>
        試験範囲の表示は IPA 公開のシラバスをもとにした目安です。最新の出題範囲は
        <a href="https://www.ipa.go.jp/shiken/syllabus/" rel="noopener">IPA 試験要綱・シラバス</a>
        を確認してください。
      </p>
    </footer>
    <script>
      import '../scripts/filter';
      import '../scripts/stepper';
      import '../scripts/progress-marks';

      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      toggle?.addEventListener('click', () => {
        const open = document.body.classList.toggle('nav-open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      // サイドバー内だけをスクロールして現在のトピックを見える位置に出す
      const sidebar = document.querySelector<HTMLElement>('.sidebar');
      const current = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
      if (sidebar && current) {
        const top = current.getBoundingClientRect().top - sidebar.getBoundingClientRect().top;
        sidebar.scrollTop += top - sidebar.clientHeight / 2;
      }
    </script>
  </body>
</html>
